{{ 'ct-secoes.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="ct-wrap ct-conceito">
    <p class="ct-conceito__texto">{{ section.settings.texto }}</p>
    <div class="ct-conceito__pontos" aria-hidden="true">
      <span></span><span></span><span class="pulo-g"></span><span></span>
    </div>
    <div class="ct-conceito__fim">
      {%- if section.settings.frase != blank -%}<p class="ct-rotulo">{{ section.settings.frase }}</p>{%- endif -%}
      {%- if section.settings.botao_texto != blank and section.settings.botao_link != blank -%}
        <a href="{{ section.settings.botao_link }}" class="ct-botao ct-botao--verde">{{ section.settings.botao_texto }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Conceito",
  "tag": "section",
  "class": "section-ct-conceito",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Contratempo é o som fora do tempo forte. É o que dá balanço ao samba, ao choro e ao baião. É também o nosso jeito de olhar o Brasil: sair do lugar esperado para enxergar o que sempre esteve ali." },
    { "type": "text", "id": "frase", "label": "Frase", "default": "A gente conhece bem os contratempos." },
    { "type": "text", "id": "botao_texto", "label": "Botão: texto", "default": "Ler o manifesto →" },
    { "type": "url", "id": "botao_link", "label": "Botão: link" }
  ],
  "presets": [{ "name": "Conceito" }]
}
{% endschema %}
