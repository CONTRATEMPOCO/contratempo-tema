{{ 'ct-secoes.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tem_imagem = false
  for block in section.blocks
    if block.settings.imagem != blank
      assign tem_imagem = true
    endif
  endfor
-%}

{%- if tem_imagem or request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    {%- if section.settings.titulo != blank -%}
      <div class="ct-wrap ct-imagens__topo"><h2 class="ct-titulo-l">{{ section.settings.titulo }}</h2></div>
    {%- endif -%}
    <div class="ct-wrap ct-grade-2 ct-imagens" style="padding-bottom: {{ section.settings.espaco_abaixo }}px">
      {%- for block in section.blocks -%}
        <figure class="ct-imagens__figura" {{ block.shopify_attributes }}>
        <div class="ct-imagens__item">
          {%- if block.settings.imagem != blank -%}
            {{ block.settings.imagem | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1400', sizes: '(min-width: 750px) 50vw, 100vw' }}
          {%- else -%}
            <div class="ct-espaco-imagem" style="height: 100%">Escolha uma imagem</div>
          {%- endif -%}
        </div>
        {%- if block.settings.rotulo != blank or block.settings.legenda != blank -%}
          <figcaption class="ct-imagens__legenda"><span class="ct-mono">{{ block.settings.rotulo }}</span> {{ block.settings.legenda }}</figcaption>
        {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Duas imagens",
  "tag": "section",
  "class": "section-ct-imagens",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de cores", "default": "scheme-1" },
    { "type": "text", "id": "titulo", "label": "Título" },
    { "type": "range", "id": "espaco_abaixo", "label": "Espaço abaixo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "imagem",
      "name": "Imagem",
      "settings": [
        { "type": "image_picker", "id": "imagem", "label": "Imagem", "info": "Preencha o texto alternativo da imagem na biblioteca de arquivos." },
        { "type": "text", "id": "rotulo", "label": "Rótulo da legenda" },
        { "type": "text", "id": "legenda", "label": "Legenda" }
      ]
    }
  ],
  "presets": [{ "name": "Duas imagens", "blocks": [{ "type": "imagem" }, { "type": "imagem" }] }]
}
{% endschema %}
