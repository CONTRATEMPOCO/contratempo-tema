{%- comment -%}
  Tabela de medidas (metacampo custom.tabela_medidas) e aviso de que não há troca de tamanho.
  Parâmetros: product, block_id.
{%- endcomment -%}
{%- assign tabela = product.metafields.custom.tabela_medidas -%}
<div class="ct-tamanho">
  {%- if tabela != blank -%}
    <details class="ct-tabela" id="TabelaMedidas-{{ block_id }}">
      <summary class="ct-tabela__botao">Tabela de medidas</summary>
      <div class="ct-tabela__conteudo rte">
        {%- if tabela.type == 'multi_line_text_field' -%}
          {%- assign linhas = tabela.value | newline_to_br | split: '<br />' -%}
          <table>
            <caption class="visually-hidden">Medidas da peça</caption>
            {%- assign cabecalho_feito = false -%}
            {%- for linha in linhas -%}
              {%- assign l = linha | strip -%}
              {%- if l == blank -%}{%- continue -%}{%- endif -%}
              {%- assign colunas = l | split: '|' -%}
              <tr>
                {%- for coluna in colunas -%}
                  {%- if cabecalho_feito == false -%}
                    <th scope="col">{{ coluna | strip | escape }}</th>
                  {%- elsif forloop.first -%}
                    <th scope="row">{{ coluna | strip | escape }}</th>
                  {%- else -%}
                    <td>{{ coluna | strip | escape }}</td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
              {%- assign cabecalho_feito = true -%}
            {%- endfor -%}
          </table>
        {%- else -%}
          {{ tabela | metafield_tag }}
        {%- endif -%}
        <p class="ct-tabela__nota">Na dúvida, compare com uma camiseta sua que veste bem, medida deitada. Como não fazemos troca de tamanho, vale medir antes.</p>
      </div>
    </details>
  {%- endif -%}
  <div class="ct-aviso" role="note">
    {%- render 'ct-icone-aviso' -%}
    <span><strong>Não fazemos troca de tamanho.</strong> Cada peça é impressa sob pedido, então escolha com atenção e confira a tabela de medidas antes de finalizar.</span>
  </div>
</div>
